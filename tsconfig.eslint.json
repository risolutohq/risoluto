{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "noEmit": true,
    "lib": ["ES2022"]
  },
  "include": ["src/**/*", "tests/**/*", "scripts/**/*", "commitlint.config.ts", "knip.config.ts", "vitest*.config.ts"]
}
