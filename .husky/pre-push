#!/bin/sh
# ── Pre-push: fast 80/20 gate ────────────────────────────────────────
# Catches the two things that actually waste CI minutes:
#   1. Compilation errors (build)
#   2. Broken tests (vitest)
#   3. Type errors (typecheck)
#
# Everything else (lint, format, knip, typecheck:coverage) is handled by
# pre-commit hooks, agent hooks,
# or CI — where it runs in parallel on clean containers.
#
# Escape hatches:
#   SKIP_HOOKS=1 git push        → skip build/test/typecheck (emergency)
#   FULL_CHECK=1 git push        → run the full CI-mirror suite
#
# Note: PRD drift check runs unconditionally — SKIP_HOOKS does NOT bypass it.

set -e

# ── Capture push refs (once, for all checks) ────────────────────────
z40=0000000000000000000000000000000000000000
refs_file=$(mktemp)
trap 'rm -f "$refs_file"' EXIT
cat > "$refs_file"

all_deletes=true
while read local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" != "$z40" ]; then
    all_deletes=false
    break
  fi
done < "$refs_file"

# ── Slug consistency check (unconditional — not affected by SKIP_HOOKS) ────
if [ "$all_deletes" = false ]; then
  echo "🔑 Checking slug consistency..."
  pnpm run slug:check
fi

# ── Skip on branch deletes ───────────────────────────────────────────
if [ "$all_deletes" = true ]; then
  echo "🗑️  Branch delete only — skipping pre-push checks."
  exit 0
fi

# ── Emergency bypass ─────────────────────────────────────────────────
if [ "${SKIP_HOOKS:-0}" = "1" ]; then
  echo "⚠️  SKIP_HOOKS=1 — skipping build/test/typecheck (PRD drift check already ran)."
  exit 0
fi

# ── Full CI-mirror mode (opt-in) ─────────────────────────────────────
if [ "${FULL_CHECK:-0}" = "1" ]; then
  echo "🔒 FULL_CHECK=1 — running full CI-mirror suite..."
  pnpm run build
  pnpm run lint
  pnpm run format:check
  pnpm test
  pnpm run typecheck
  pnpm run knip
  command -v gitleaks >/dev/null 2>&1 && gitleaks detect --config .gitleaks.toml --verbose || echo "⚠️  gitleaks not installed — skipping."
  pnpm run typecheck:coverage
  echo "✅ Full CI-mirror suite passed!"
  exit 0
fi

# ── Path gate: skip build/test/typecheck when nothing gate-relevant changed ──
# Docs/skills/markdown-only pushes cannot affect build, tests, or types, so the
# heavy gate is pure wait for them. Anything touching code, config, tests, or
# deps still runs it. New remote branches always run it (can't cheaply diff).
# Force the full run with FULL_CHECK=1 (handled above).
need_gate=false
changed_files=""
while read local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$z40" ] && continue
  if [ "$remote_sha" = "$z40" ]; then
    need_gate=true
    break
  fi
  changed_files="$changed_files
$(git diff --name-only "$remote_sha" "$local_sha")"
done < "$refs_file"

if [ "$need_gate" = false ] && printf '%s\n' "$changed_files" | grep -Eq '^(src/|tests/|scripts/|package\.json|pnpm-lock\.yaml|tsconfig.*\.json|vitest\..*\.ts|.*\.config\.(ts|js|cjs|mjs))'; then
  need_gate=true
fi

if [ "$need_gate" = false ]; then
  echo "📄 No code/config/test/deps changes in this push — skipping build/test/typecheck."
  echo "   (PRD drift check already ran; use FULL_CHECK=1 to force the full suite.)"
  exit 0
fi

# ── Fast 80/20 gate (default) ────────────────────────────────────────
# Run build, tests, and format:check in parallel — they're independent.
# Drop `pnpm run typecheck` (redundant with `build`: tsconfig has
# noEmitOnError:true so build already fails on type errors, and the
# CI Quality job now runs `typecheck:coverage` to enforce the >=95% gate).
echo "🎨 Checking formatting..."
pnpm run format:check &
fmt_pid=$!

echo "🔨 Building..."
pnpm run build &
build_pid=$!

echo "🧪 Running tests..."
pnpm test &
test_pid=$!

# Surface the first non-zero exit code from any backgrounded gate.
wait $fmt_pid || exit 1
wait $build_pid || exit 1
wait $test_pid || exit 1

echo "✅ Pre-push checks passed! (use FULL_CHECK=1 for the full suite)"
